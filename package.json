{
  "name": "whats-app-messages-api-net-angular",
  "version": "1.0.0",
  "description": "WhatsApp Messages with Angular frontend and .NET backend",
  "scripts": {
    "start": "docker-compose up -d && node -e \"setTimeout(() => {}, 10000)\" && start http://localhost:4200/",
